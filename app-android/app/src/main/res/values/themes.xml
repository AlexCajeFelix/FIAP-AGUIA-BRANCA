<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AguiaHub" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.AguiaHub.Main</item>
    </style>

    <style name="Theme.AguiaHub.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:navigationBarColor">@color/brand_navy_deep</item>
        <item name="android:windowBackground">@color/brand_navy</item>
    </style>
</resources>
