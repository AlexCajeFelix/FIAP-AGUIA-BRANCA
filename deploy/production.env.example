# Deploy MANUAL de producao: cp deploy/production.env.example deploy/production.env
# e depois: scripts/deploy.sh production ghcr.io/alexcajefelix/fiap-aguia-branca:production
#
# No pipeline estes valores vem dos secrets do environment "production" no GitHub
# (Settings -> Environments -> production), que tambem exige aprovacao manual.

APP_PORT=8083
MONGO_DB=aguiabranca
# Obrigatorio e diferente do de staging: token de um ambiente nao pode valer no outro.
JWT_SECRET=troque-por-openssl-rand-base64-48
CORS_ALLOWED_ORIGINS=
GEMINI_API_KEY=
