# Deploy MANUAL de staging: cp deploy/staging.env.example deploy/staging.env
# e depois: scripts/deploy.sh staging ghcr.io/alexcajefelix/fiap-aguia-branca:staging
#
# No pipeline estes valores vem dos secrets do environment "staging" no GitHub
# (Settings -> Environments -> staging), nunca de arquivo versionado.

APP_PORT=8082
MONGO_DB=aguiabranca_staging
# Obrigatorio. O valor publico de dev e recusado fora do profile dev.
JWT_SECRET=troque-por-openssl-rand-base64-48
GEMINI_API_KEY=
