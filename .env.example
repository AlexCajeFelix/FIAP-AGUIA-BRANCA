# Ambiente LOCAL (docker compose up -d --build). Copie para .env e ajuste.
# Staging e producao tem os proprios modelos em deploy/*.env.example.

# --- MongoDB ---
MONGO_DB=aguiabranca
MONGO_PORT=27017

# --- API Spring Boot ---
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_ENVIRONMENT=local
# Minimo 32 bytes. Gere um com: openssl rand -base64 48
JWT_SECRET=segredo-de-dev-com-mais-de-32-bytes-para-hs256-autenticacao

# Origens liberadas para CORS, separadas por virgula. Vazio = nenhuma (o app Android nao precisa).
CORS_ALLOWED_ORIGINS=

# Chave do Gemini (opcional). Sem ela, POST /ideas/suggest responde 404 e o resto da API
# funciona normalmente — nenhum teste e nenhum build dependem deste valor.
GEMINI_API_KEY=
